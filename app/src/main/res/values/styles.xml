<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MovieAssessment" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#1F1F29</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.MovieAssessment.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MovieAssessment</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/brand_canvas</item>
        <item name="android:navigationBarColor">@color/brand_canvas</item>
    </style>
</resources>
